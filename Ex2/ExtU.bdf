(text "实验2-2  ExtU：立即数扩展部件（Extop=00 ZExt(imma) / 01 SExt(imma) / 10 SExt(immb) / 11 immc‖0）" (rect 0 -96 1102 -74)(font "Arial" (font_size 14)(bold)))
(text "常数0" (rect 400 40 435 54)(font "Arial" (font_size 8)))
(text "4路32位选择器（lpm_mux0）" (rect 928 8 1171 24)(font "Arial" (font_size 10)(bold)))
(text "Extop=00（ori）：I型imma = Imm[31..20]，零扩展：IZero[11..0]=imma，IZero[31..12]=0" (rect 0 248 679 264)(font "Arial" (font_size 10)(bold)))
(text "Extop=01（lw）：I型imma = Imm[31..20]，符号扩展：ISign[11..0]=imma，ISign[31..12]=Imm[31]" (rect 0 480 750 496)(font "Arial" (font_size 10)(bold)))
(text "Extop=11（lui）：U型immc = Imm[31..12]，拼接：UUpper[31..12]=immc，UUpper[11..0]=0" (rect 0 944 696 960)(font "Arial" (font_size 10)(bold)))
(text "输入/输出引脚" (rect 0 -40 125 -24)(font "Arial" (font_size 10)(bold)))
