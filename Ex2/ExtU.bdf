(text "12" (rect 560 -48 574 -34)(font "Arial" (font_size 8)))
(text "12" (rect 720 -48 734 -34)(font "Arial" (font_size 8)))
(text "20" (rect 872 -48 886 -34)(font "Arial" (font_size 8)))
